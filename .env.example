# =============================================================================
# Polymarket Fact Checker — environment variables
# =============================================================================
# Copy to `.env` / Convex dashboard / Vercel as appropriate.
# Never commit real secrets.
#
# LLM (required for chat + embeddings): Google Gemini via @google/genai
# Docs: https://ai.google.dev/gemini-api/docs/models
#       https://ai.google.dev/gemini-api/docs/embeddings
# =============================================================================

# --- Client (Vite / Vercel) ---
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# --- Convex (server-side actions) & optional Node server ---
# Required
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# Optional Matryoshka output size: 768, 1536, or 3072 (default 3072)
# GEMINI_EMBED_DIMENSIONS=1536

# Force provider (default: gemini when GEMINI_API_KEY is set)
# LLM_PROVIDER=gemini

# Polymarket
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
APP_PUBLIC_BASE_URL=http://localhost:5173

# Optional data sources
# TWITTER_BEARER_TOKEN=
# NEWS_API_KEY=
# TIKTOK_API_KEY=
# TIKTOK_API_SECRET=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_ID=
# KALSHI_API_KEY=
# KALSHI_API_SECRET=

# NOTE: After switching embed models (e.g. from OpenAI text-embedding-3-small
# 1536-d to Gemini gemini-embedding-2 3072-d), re-run market ingestion so
# stored vectors match the new dimensions:
#   npx convex run actions/ingestMarkets:ingestMarkets '{"cursor":null}'
