# =============================================================================
# Polymarket Fact Checker — environment variables
# =============================================================================
# Copy to Convex dashboard / Vercel / local `.env` as appropriate.
# Never commit real secrets.
#
# Chat: One Gateway (OpenAI-compatible) — https://github.com/abrown84/one-gateway
# Embeddings: Google Gemini via @google/genai (one-gateway has no embeddings API)
#   https://ai.google.dev/gemini-api/docs/embeddings
# =============================================================================

# --- Client (Vite / Vercel) ---
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# --- Chat via One Gateway (required in Convex for AI chat) ---
# Token from your OpenClaw / One Gateway host (openclaw.json → gateway.auth.token)
ONE_GATEWAY_TOKEN=
# Public HTTPS URL of the gateway (must be reachable from Convex cloud)
ONE_GATEWAY_URL=https://your-gateway.example.com
# Model routed by the gateway (default shown)
ONE_GATEWAY_MODEL=gemini-3.8-flash
# Optional
# ONE_GATEWAY_AGENT=main
# ONE_GATEWAY_FALLBACKS=
# ONE_GATEWAY_TEMPERATURE=0.2
# ONE_GATEWAY_MAX_TOKENS=2000
# ONE_GATEWAY_TIMEOUT_MS=45000
# Legacy aliases still accepted: OPENCLAW_GATEWAY_TOKEN, OPENCLAW_BASE_URL, OPENCLAW_CHAT_MODEL

# --- Embeddings via Gemini (required in Convex; one-gateway does not embed) ---
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2
# Optional Matryoshka size: 768, 1536, or 3072 (default 3072)
# GEMINI_EMBED_DIMENSIONS=1536
# Optional alias for chat model if ONE_GATEWAY_MODEL unset:
# GEMINI_CHAT_MODEL=gemini-3.8-flash

# LLM_PROVIDER=one-gateway

# Polymarket
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
APP_PUBLIC_BASE_URL=http://localhost:5173

# Optional data sources
# TWITTER_BEARER_TOKEN=
# NEWS_API_KEY=
# TIKTOK_API_KEY=
# TIKTOK_API_SECRET=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_ID=
# KALSHI_API_KEY=
# KALSHI_API_SECRET=

# NOTE: After switching embed models (e.g. from OpenAI text-embedding-3-small
# 1536-d to Gemini gemini-embedding-2 3072-d), re-run market ingestion so
# stored vectors match the new dimensions:
#   npx convex run actions/ingestMarkets:ingestMarkets '{"cursor":null}'
