# =============================================================================
# Polymarket Fact Checker — environment variables
# =============================================================================
# Copy to Convex dashboard / Vercel / local `.env` as appropriate.
# Never commit real secrets.
#
# All AI (chat + embeddings) goes through One Gateway (OpenAI-compatible):
#   https://github.com/abrown84/one-gateway
# Default public URL: https://brwnindustries.com/labs/one-gateway
#   POST {ONE_GATEWAY_URL}/v1/chat/completions
#   POST {ONE_GATEWAY_URL}/v1/embeddings   (Gemini embeddings, 3072 dims)
# Token is optional — Authorization is sent only when ONE_GATEWAY_TOKEN is set.
# =============================================================================

# --- Client (Vite / Vercel) ---
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# --- One Gateway (chat + embeddings) — used by Convex AI actions ---
# Public HTTPS base URL (no trailing slash; /v1 is appended by the client)
ONE_GATEWAY_URL=https://brwnindustries.com/labs/one-gateway
# Optional bearer token (omit if the gateway allows unauthenticated access)
# ONE_GATEWAY_TOKEN=
# Chat model (default shown)
ONE_GATEWAY_MODEL=gemini-3.8-flash
# Embed model (default shown; gateway returns 3072-d Gemini embeddings)
ONE_GATEWAY_EMBED_MODEL=gemini-embedding-2
# Optional expected embed size for re-index checks (default 3072)
# ONE_GATEWAY_EMBED_DIMENSIONS=3072
# Optional
# ONE_GATEWAY_AGENT=main
# ONE_GATEWAY_FALLBACKS=
# ONE_GATEWAY_TEMPERATURE=0.2
# ONE_GATEWAY_MAX_TOKENS=2000
# ONE_GATEWAY_TIMEOUT_MS=45000
# Legacy aliases still accepted: OPENCLAW_GATEWAY_TOKEN, OPENCLAW_BASE_URL,
# OPENCLAW_CHAT_MODEL, GEMINI_CHAT_MODEL, GEMINI_EMBED_MODEL, GEMINI_EMBED_DIMENSIONS

# LLM_PROVIDER=one-gateway

# Polymarket
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
APP_PUBLIC_BASE_URL=http://localhost:5173

# Optional data sources
# TWITTER_BEARER_TOKEN=
# NEWS_API_KEY=
# TIKTOK_API_KEY=
# TIKTOK_API_SECRET=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_ID=
# KALSHI_API_KEY=
# KALSHI_API_SECRET=

# NOTE: Gateway Gemini embeddings are 3072-d. If stored vectors are still
# OpenAI text-embedding-3-small (1536-d) or any other size, cosine search
# skips those markets until you re-ingest:
#   npx convex run actions/ingestMarkets:ingestMarkets '{"cursor":null}'
